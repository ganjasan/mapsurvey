# Per-worktree port isolation.
#
# Copy this file to `.env.ports` in each worktree and pick a UNIQUE offset so
# multiple worktrees/projects can run dev + tests in parallel without colliding
# on host ports. `.env.ports` is gitignored; this example is tracked.
#
# Every host port is derived as BASE + PORT_OFFSET:
#   PostGIS  5434 + OFFSET
#   Redis    6379 + OFFSET
#   web      8000 + OFFSET
#
# Keep a registry here so two worktrees never grab the same offset:
#   0   -> main checkout      (5434 / 6379 / 8000)
#   10  -> Mapsurvey-ai-generator (5444 / 6389 / 8010)
#   20  -> <worktree-slug>    (5454 / 6399 / 8020)
#   30  -> Mapsurvey-overview-tiles (5464 / 6409 / 8030)
#   40  -> Mapsurvey-picker-fix (5474 / 6419 / 8040)
#   50  -> Mapsurvey-other-writein (5484 / 6429 / 8050)
#   270 -> Mapsurvey-comment-threads (5704 / 6649 / 8270)
#   280 -> Mapsurvey-layer-memory (5714 / 6659 / 8280)
#   290 -> Mapsurvey-gunicorn-drain (5724 / 6669 / 8290)
#   300 -> Mapsurvey-py312 (5734 / 6679 / 8300)
#   310 -> Mapsurvey-draft-body-loss (5744 / 6689 / 8310)
#   320 -> Mapsurvey-worker-drain (5754 / 6699 / 8320)
#   340 -> Mapsurvey-responses-map (5774 / 6719 / 8340)
#   360 -> Mapsurvey-layer-editor-category (5794 / 6739 / 8360)

PORT_OFFSET=10

# Isolates docker-compose containers/networks/volumes per worktree, so
# `docker compose down -v` only ever touches this worktree's data.
COMPOSE_PROJECT_NAME=mapsurvey-myfeature
