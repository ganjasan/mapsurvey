# Per-worktree port isolation.
#
# Copy this file to `.env.ports` in each worktree and pick a UNIQUE offset so
# multiple worktrees/projects can run dev + tests in parallel without colliding
# on host ports. `.env.ports` is gitignored; this example is tracked.
#
# Every host port is derived as BASE + PORT_OFFSET:
#   PostGIS  5434 + OFFSET
#   Redis    6379 + OFFSET
#   web      8000 + OFFSET
#
# Keep a registry here so two worktrees never grab the same offset:
#   0   -> main checkout      (5434 / 6379 / 8000)
#   10  -> Mapsurvey-loading-bar (5444 / 6389 / 8010; the ai-generator worktree is gone)
#   20  -> <worktree-slug>    (5454 / 6399 / 8020)
#   30  -> Mapsurvey-overview-tiles (5464 / 6409 / 8030)
#   40  -> Mapsurvey-picker-fix (5474 / 6419 / 8040)
#   50  -> Mapsurvey-other-writein (5484 / 6429 / 8050)
#   270 -> Mapsurvey-comment-threads (5704 / 6649 / 8270)
#   280 -> Mapsurvey-layer-memory (5714 / 6659 / 8280)
#   290 -> Mapsurvey-gunicorn-drain (5724 / 6669 / 8290)
#   300 -> Mapsurvey-py312 (5734 / 6679 / 8300)
#   310 -> Mapsurvey-draft-body-loss (5744 / 6689 / 8310)
#   320 -> Mapsurvey-worker-drain (5754 / 6699 / 8320)
#   340 -> Mapsurvey-responses-map (5774 / 6719 / 8340)
#   370 -> Mapsurvey-layer-object-key-collision (5804 / 6749 / 8370)
#   440 -> Mapsurvey-changelog (5874 / 6819 / 8440)
#   520 -> Mapsurvey-phishing-review (5954 / 6899 / 8520)
#   400 -> Mapsurvey-export-formats (5834 / 6779 / 8400)
#   380 -> settings-autosave worktree (5814 / 6759 / 8380) — found in use, was unregistered
#   960 -> Mapsurvey-pricing (6394 / 7339 / 8960)
#   950 -> Mapsurvey-fix-logout (6384 / 7329 / 8950)
#   630 -> Mapsurvey-request-demo (6064 / 7009 / 8630)
#   640 -> Mapsurvey-demo-focus (6074 / 7019 / 8640)
#   650 -> Mapsurvey-terms-checkbox (6084 / 7029 / 8650)
#   390 -> in use by another worktree (5824 / 6769 / 8390) — owner unknown
#   410 -> Mapsurvey-olney-story (5844 / 6789 / 8410)
#   420 -> Mapsurvey-stories-batch2 (5854 / 6799 / 8420)
#   450 -> htmx-ajax-unhandled-rejection (5884 / 6829 / 8450)
#   600 -> Mapsurvey-embed (6034 / 6979 / 8600)
#   560 -> Mapsurvey-market-guide (5994 / 6939 / 8560)
#   460 -> Mapsurvey-coverage-layer (5894 / 6839 / 8460)
#   990 -> Mapsurvey-star-dup (6424 / 7369 / 8990)
#   1000 -> Mapsurvey-translation-table (6434 / 7379 / 9000)
#   470 -> Mapsurvey-seo-landings (5904 / 6849 / 8470)
#   480 -> Mapsurvey-citizen-landing (5914 / 6859 / 8480)
#   60  -> Mapsurvey-dashboard-perf (5494 / 6439 / 8060)
#   70  -> Mapsurvey-start-one-click (5504 / 6449 / 8070)
#   530 -> Mapsurvey-spraycan (5964 / 6909 / 8530)
#   490 -> Mapsurvey-paywall (5924 / 6869 / 8490)
#   570 -> Mapsurvey-export-invalid-geom (6004 / 6949 / 8570)
#   580 -> Mapsurvey-large-object-body (6014 / 6959 / 8580) — found in use, was unregistered
#   590 -> Mapsurvey-answered-rule (6024 / 6969 / 8590)
#   650 -> Mapsurvey-subq-visibility (6084 / 7029 / 8650)
#   660 -> Mapsurvey-onboarding (6094 / 7039 / 8660)
#   670 -> Mapsurvey-tap-to-place (6104 / 7049 / 8670)
#   640 -> Mapsurvey-help-site (6074 / 7019 / 8640)
#   770 -> Mapsurvey-lang-save (6204 / 7149 / 8770)
#   880 -> Mapsurvey-changelog-hero (6314 / 7259 / 8880)
#   30  -> Mapsurvey-oauth-server (5464 / 6409 / 8030)
#   730 -> Mapsurvey-mcp-server (6164 / 7109 / 8730)

PORT_OFFSET=10

# Isolates docker-compose containers/networks/volumes per worktree, so
# `docker compose down -v` only ever touches this worktree's data.
COMPOSE_PROJECT_NAME=mapsurvey-myfeature
