# The build must depend on tracked sources only. `collectstatic` runs inside the image
# (Dockerfile), so anything the host happens to have built or configured has no business
# entering the context.

# Local virtualenv — in a worktree this is a symlink to the main checkout's env/.
env/
venv/
.venv/

# Collected static output: regenerated by the build step.
staticfiles/

# Local uploads. On Render media lives on the mounted disk, never in the image.
mediafiles/
media/

# Secrets and local port assignments. On Render the context is a clean clone and these
# do not exist; locally they must not be baked into an image.
.env
.env.*
!.env.example
!.env.ports.example

.git/
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Tooling and specs that no runtime code reads. `docs/` is deliberately NOT excluded:
# survey/tests.py reads docs/marketing/cohorts/ and the suite can be run inside the image.
openspec/
loadtest/
.claude/
node_modules/
