# Django settings
SECRET_KEY=change-me-in-production
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Database settings (Django)
SQL_ENGINE=django.contrib.gis.db.backends.postgis
SQL_DATABASE=mapsurvey
SQL_USER=mapsurvey
SQL_PASSWORD=mapsurvey
SQL_HOST=db
SQL_PORT=5432

# PostgreSQL container settings
POSTGRES_DB=mapsurvey
POSTGRES_USER=mapsurvey
POSTGRES_PASSWORD=mapsurvey

# Superuser (auto-created on startup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminadmin

# Mapbox (optional — get a token at https://account.mapbox.com/)
# MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Email backend (optional — defaults to console backend for dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.privateemail.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=hello@mapsurvey.org
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Mapsurvey <hello@mapsurvey.org>

# S3 media storage (optional)
# USE_S3=TRUE
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# Cloudflare Turnstile (CAPTCHA on /accounts/register/).
# Defaults below are Cloudflare's public always-pass test keys —
# they exercise the full code path while always returning success.
# Replace with real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# When True, trust HTTP_CF_CONNECTING_IP for client IP detection.
# Set to True only on deployments actually behind Cloudflare.
# In local dev keep False — the header is spoofable.
CLOUDFLARE_TRUSTED=False

# Per-IP rate limits on /accounts/register/ POST.
REGISTRATION_RATE_LIMIT_HOUR=3
REGISTRATION_RATE_LIMIT_DAY=10

# Redis (rate-limiting counters). On Render this comes from the
# mapsurvey-redis service automatically.
REDIS_URL=redis://localhost:6379/1
