# Django settings
SECRET_KEY=change-me-in-production
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# Database settings (Django)
SQL_ENGINE=django.contrib.gis.db.backends.postgis
SQL_DATABASE=mapsurvey
SQL_USER=mapsurvey
SQL_PASSWORD=mapsurvey
SQL_HOST=db
SQL_PORT=5432

# PostgreSQL container settings
POSTGRES_DB=mapsurvey
POSTGRES_USER=mapsurvey
POSTGRES_PASSWORD=mapsurvey

# Superuser (auto-created on startup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminadmin

# Mapbox (optional — get a token at https://account.mapbox.com/)
# MAPBOX_ACCESS_TOKEN=pk.your_token_here

# Email backend (optional — defaults to console backend for dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.privateemail.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=hello@mapsurvey.org
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Mapsurvey <hello@mapsurvey.org>

# S3 media storage (optional)
# USE_S3=TRUE
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# Cloudflare Turnstile (CAPTCHA on /accounts/register/).
# Defaults below are Cloudflare's public always-pass test keys —
# they exercise the full code path while always returning success.
# Replace with real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# When True, trust HTTP_CF_CONNECTING_IP for client IP detection.
# Set to True only on deployments actually behind Cloudflare.
# In local dev keep False — the header is spoofable.
CLOUDFLARE_TRUSTED=False

# Per-IP rate limits on /accounts/register/ POST.
REGISTRATION_RATE_LIMIT_HOUR=3
REGISTRATION_RATE_LIMIT_DAY=10

# Redis (rate-limiting counters). On Render this comes from the
# mapsurvey-redis service automatically.
REDIS_URL=redis://localhost:6379/1

# Discord Incoming Webhook — posts release/changelog updates to the community channel.
# Create one in Discord: Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL.
# Consumed by scripts/notify_discord.sh. In CI, supply it as a secret env var instead of committing it.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Discord bot token — lets tooling manage the server (create/rename channels, webhooks, roles)
# via the Discord REST API, beyond what a webhook can do. Create a bot at
# https://discord.com/developers/applications → Bot → Reset Token. Keep it secret (gitignored).
# DISCORD_BOT_TOKEN=

# Public Discord invite shown as a "Join our Discord" CTA on the landing page.
# Has a working default in settings.py; override here to point at another invite.
# DISCORD_INVITE_URL=https://discord.gg/XXXXXXXX

# --- Acquisition metrics (funnel dashboard, section ② Acquisition) ---
# All optional. Unset = the dashboard shows "not configured" for that source,
# which is deliberate: it never renders a missing source as a zero.
# Sync with: python manage.py sync_acquisition_metrics --days 7
#
# Google Search Console. Local dev reads a service-account key file; production
# passes the same JSON through GSC_SERVICE_ACCOUNT_JSON instead (Render has no
# secret files). Never commit the key itself.
# GSC_SITE=sc-domain:mapsurvey.org
# GSC_KEY=/absolute/path/to/service-account.json
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Plausible Stats API. Requires an API key created in the Plausible account.
# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=mapsurvey.org

# --- Internal product analytics (PostHog) ---
# How WE are doing: which creator-facing screens get used, where activation leaks.
# NOT the respondent analytics we sell to creators -- that is SurveyEvent in our own
# database (survey/events.py) and never leaves it.
#
# Unset (the default) renders no snippet at all: no script tag, no network call. Keep it
# unset locally unless you specifically want to test the integration, and point it at a
# throwaway PostHog project when you do -- otherwise dev traffic lands in production.
#
# The snippet never loads on /surveys/ or /r/ regardless of this key; see
# POSTHOG_EXCLUDED_PREFIXES in settings.py.
#
# The same key also enables SERVER-SIDE error capture (Django view exceptions via
# PosthogContextMiddleware, Celery task failures via the task_failure receiver in
# mapsurvey/celery.py). Unset still means fully off -- the client is explicitly
# disabled in survey.apps.SurveyConfig, so no capture path can emit anything.
# POSTHOG_PROJECT_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Cloud EU by default. Override for Cloud US (https://us.i.posthog.com), a self-hosted
# instance, or a reverse proxy on our own domain.
# POSTHOG_API_HOST=https://eu.i.posthog.com
