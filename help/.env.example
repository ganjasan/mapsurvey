# Build-time variables for the help site. All optional.
#
# PostHog: unset = no analytics script on any page (same gating as the product).
# PUBLIC_POSTHOG_KEY=phc_...
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# Render sets IS_PULL_REQUEST=true on preview builds; every page then carries
# <meta name="robots" content="noindex">. Set it locally to test that path.
# IS_PULL_REQUEST=true
