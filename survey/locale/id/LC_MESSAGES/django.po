#: survey/models.py:321
msgid ""
"URL to redirect after survey completion. E.g.: /thanks/ or "
"https://example.com"
msgstr ""
"URL tujuan pengalihan setelah survei selesai. Mis.: /thanks/ atau "
"https://example.com"

#: survey/models.py:322
msgid "List of ISO 639-1 language codes, e.g. [\"en\", \"ru\", \"de\"]"
msgstr "Daftar kode bahasa ISO 639-1, mis. [\"en\", \"ru\", \"de\"]"

