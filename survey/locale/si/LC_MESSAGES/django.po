msgid "{item} dropped at position {position}"
msgstr "{item} ස්ථානය {position} හි තැබුවා"

msgid "{item} moved to position {position}"
msgstr "{item} ස්ථානය {position} වෙත ගෙන ගියා"

msgid "{item} picked up. Use the arrow keys to move it, Space to drop it."
msgstr ""
"{item} ඔසවා ගත්තා. එය ගෙන යාමට ඊතල යතුරු ද, තැබීමට Space ද භාවිත කරන්න."

msgid "{n} marked"
msgstr "{n} ක් සලකුණු කළා"

msgid "{n} of {m} marked"
msgstr "{m} න් {n} ක් සලකුණු කළා"

#, python-format
msgid "… and %(n)s more"
msgstr "… සහ තවත් %(n)s ක්"
