msgstr ""
"Viene impostato quando la demo è aperta da un utente autenticato; NULL = "
"anonimo."

#: survey/models.py:1442
msgid "Unlisted"
msgstr "Non elencato"

#: survey/models.py:1446
#: survey/templates/editor/partials/_publishing_widget.html:59
#: survey/templates/editor/public_results.html:49
msgid "Live"
msgstr "In diretta"

#: survey/models.py:1447 survey/templates/editor/public_results.html:49
msgid "Frozen"
msgstr "Congelato"

#: survey/models.py:1453
msgid "Chart"
msgstr "Grafico"

#: survey/models.py:1477
msgid ""
"Public is indexable and listable; unlisted is reachable by direct link only."
msgstr ""
"Pubblico è indicizzabile e compare negli elenchi; non elencato è "
"raggiungibile solo tramite link diretto."

#: survey/models.py:1482
msgid ""
"Multilingual intro: {\"title\": {\"en\": ...}, \"body\": {\"en\": ...}} or "
"plain strings."
msgstr ""
"Introduzione multilingue: {\"title\": {\"en\": ...}, \"body\": {\"en\": "
"...}} oppure testo semplice."

#: survey/models.py:1485
msgid "Frozen per-block payloads."
msgstr "Dati congelati per ciascun blocco."

#: survey/models.py:1491
msgid ""
"Show a \"See the results\" button on the survey's thanks page (only while "
"published)."
msgstr ""
"Mostra un pulsante «Guarda i risultati» nella pagina di ringraziamento del "
"sondaggio (solo mentre è pubblicato)."

#: survey/models.py:1494
msgid "Show a card in the public stories listing (public visibility only)."
msgstr ""
"Mostra una scheda nell’elenco pubblico delle storie (solo con visibilità "
"pubblica)."

#: survey/models.py:1497
msgid "Mask buckets with 0 < count < K as \"<K\". Set to 1 to disable."
msgstr ""
"Maschera i gruppi con 0 < conteggio < K come «<K». Imposta 1 per "
"disattivare."

#: survey/models.py:1501
msgid ""
"When default blocks were auto-drafted. Set once; blocks the creator deletes "
"are never re-created."
msgstr ""
"Quando i blocchi predefiniti sono stati creati automaticamente. Impostato "
"una sola volta; i blocchi eliminati da chi crea il sondaggio non vengono mai"
" ricreati."

#: survey/models.py:1528
msgid "Bound question for chart/map blocks; null for text/image."
msgstr ""
"Domanda collegata per i blocchi grafico e mappa; vuoto per testo e immagine."

#: survey/models.py:1533
msgid "Visualization override: auto, bar, pie, donut, table, heatmap, ..."
msgstr ""
"Visualizzazione alternativa: auto, bar, pie, donut, table, heatmap, ..."

#: survey/models.py:1536
msgid "Optional multilingual title override."
msgstr "Titolo multilingue facoltativo che sostituisce quello predefinito."

#: survey/models.py:1540
msgid ""
"Multilingual body for standalone text blocks, or caption for image blocks: "
"{\"en\": \"...\", \"ru\": \"...\"}."
msgstr ""
"Testo multilingue per i blocchi di testo autonomi, o didascalia per i "
"blocchi immagine: {\"en\": \"...\", \"ru\": \"...\"}."

#: survey/models.py:1544
msgid "Image for standalone image blocks."
msgstr "Immagine per i blocchi immagine autonomi."

#: survey/models.py:1548
msgid ""
"Question codes whose values appear in geo popups. Empty = anonymous geometry"
" only."
msgstr ""
"Codici delle domande i cui valori compaiono nelle finestre sulla mappa. "
"Vuoto = solo geometria anonima."

#: survey/models.py:1552
msgid "Tile basemap for map blocks (streets/satellite/topo)."
msgstr ""
"Mappa di base a tasselli per i blocchi mappa (streets/satellite/topo)."

#: survey/models.py:1567
msgid "Survey draft generation"
msgstr "Generazione della bozza del sondaggio"

#: survey/models.py:1573
msgid "Pending"
msgstr "In attesa"

#: survey/models.py:1574
msgid "Success"
msgstr "Riuscita"

#: survey/models.py:1575
msgid "Provider not configured"
msgstr "Fornitore non configurato"

#: survey/models.py:1576
msgid "Provider error"
msgstr "Errore del fornitore"

#: survey/models.py:1577
msgid "Invalid draft"
