#: survey/templates/editor/partials/survey_settings_panel.html:147
msgid "Color"
msgstr "Farbe"

#: survey/models.py:675
msgid "HEX color, as #RRGGBB"
msgstr "HEX-Farbe im Format #RRGGBB"

