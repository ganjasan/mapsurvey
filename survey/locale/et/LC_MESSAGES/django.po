#: survey/models.py:321
msgid ""
"URL to redirect after survey completion. E.g.: /thanks/ or "
"https://example.com"
msgstr ""
"URL, kuhu suunata pärast küsitluse lõpetamist. Nt: /thanks/ või "
"https://example.com"

#: survey/models.py:322
msgid "List of ISO 639-1 language codes, e.g. [\"en\", \"ru\", \"de\"]"
msgstr "ISO 639-1 keelekoodide loend, nt [\"en\", \"ru\", \"de\"]"

