msgid "Form"
msgstr "Formulaire"

#: survey/models.py:566
msgid ""
"\"map\" renders the panel beside the map; \"form\" renders a classic full-"
"width form with no map"
msgstr ""
"« map » affiche le panneau à côté de la carte ; « form » affiche un "
"formulaire classique pleine largeur sans carte"

#: survey/models.py:567
msgid ""
"Custom label for the forward button, e.g. \"Start\" on a welcome section. "
"Empty = the default Next/Finish."
msgstr ""
"Libellé personnalisé du bouton suivant, p. ex. « Commencer » sur une section"
" d'accueil. Vide = Suivant/Terminer par défaut."

#: survey/models.py:575
msgid ""
"Override map position for this section. Null = keep current map position."
msgstr ""
"Remplacer la position de la carte pour cette section. Null = conserver la "
"position actuelle."

#: survey/models.py:576
msgid "Override map zoom for this section. Null = keep current zoom."
msgstr ""
"Remplacer le zoom de la carte pour cette section. Null = conserver le zoom "
"actuel."

#: survey/models.py:577
msgid "If true, fly to respondent location when entering this section."
msgstr ""
"Si activé, se déplacer vers la position du répondant à l'entrée dans cette "
"section."

#: survey/models.py:578
msgid "Override basemap for this section. Null = keep current basemap."
msgstr ""
"Remplacer le fond de carte pour cette section. Null = conserver le fond "
"actuel."

#: survey/models.py:579
msgid ""
"IDs of SurveyMapLayer rows hidden on this section. Empty = all layers "
"visible. Stale IDs are ignored at render time."
msgstr ""
"Identifiants des SurveyMapLayer masqués sur cette section. Vide = toutes les"
" couches visibles. Les identifiants obsolètes sont ignorés à l'affichage."

#: survey/models.py:587
msgid ""
"Show this section only when the referenced choice question's answer includes"
" any of the referenced option codes. Null = always shown."
msgstr ""
"N'afficher cette section que si la réponse à la question à choix référencée "
"contient l'un des codes d'option indiqués. Null = toujours affichée."

#: survey/models.py:639 survey/models.py:795
msgid "ISO 639-1 language code"
msgstr "Code de langue ISO 639-1"

#: survey/models.py:674
msgid ""
"Per-question validation: {min_value, max_value, outlier_sigma, min_length, "
"area_outlier_factor}"
msgstr ""
"Contrôles par question : {min_value, max_value, outlier_sigma, min_length, "
"area_outlier_factor}"

#: survey/models.py:675
msgid "HEX color, as #RRGGBB"
msgstr "Couleur HEX, au format #RRGGBB"

#: survey/models.py:676
msgid "Must be Font-Awesome class"
msgstr "Doit être une classe Font Awesome"

#: survey/models.py:678
msgid ""
"Rendering style: rating styles (\"default\" inherits the survey-wide style) "
"or \"dropdown\" for choice questions"
msgstr ""
"Style d'affichage : styles de notation (« default » hérite du style de "
"l'enquête) ou « dropdown » pour les questions à choix"

#: survey/models.py:681
msgid ""
"Show this question only when the referenced choice question's answer "
"includes any of the referenced option codes. Null = always shown."
msgstr ""
"N'afficher cette question que si la réponse à la question à choix référencée"
" contient l'un des codes d'option indiqués. Null = toujours affichée."

