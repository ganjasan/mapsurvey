#: survey/models.py:321
msgid ""
"URL to redirect after survey completion. E.g.: /thanks/ or "
"https://example.com"
msgstr ""
"URL de redirection après la fin de l'enquête. P. ex. : /thanks/ ou "
"https://example.com"

#: survey/models.py:322
msgid "List of ISO 639-1 language codes, e.g. [\"en\", \"ru\", \"de\"]"
msgstr "Liste de codes de langue ISO 639-1, p. ex. [\"en\", \"ru\", \"de\"]"

