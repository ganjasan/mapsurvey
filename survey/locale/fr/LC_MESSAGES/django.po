msgid "Mask buckets with 0 < count < K as \"<K\". Set to 1 to disable."
msgstr ""
"Masquer les groupes dont l'effectif est compris entre 0 et K sous la forme «"
" <K ». Mettre 1 pour désactiver."

#: survey/models.py:1501
msgid ""
"When default blocks were auto-drafted. Set once; blocks the creator deletes "
"are never re-created."
msgstr ""
"Date de génération automatique des blocs par défaut. Renseignée une seule "
"fois ; les blocs supprimés ne sont jamais recréés."

#: survey/models.py:1528
msgid "Bound question for chart/map blocks; null for text/image."
msgstr "Question associée aux blocs graphique/carte ; null pour texte/image."

#: survey/models.py:1533
msgid "Visualization override: auto, bar, pie, donut, table, heatmap, ..."
msgstr "Visualisation forcée : auto, bar, pie, donut, table, heatmap, …"

#: survey/models.py:1536
msgid "Optional multilingual title override."
msgstr "Titre multilingue facultatif remplaçant celui par défaut."

#: survey/models.py:1540
msgid ""
"Multilingual body for standalone text blocks, or caption for image blocks: "
"{\"en\": \"...\", \"ru\": \"...\"}."
msgstr ""
"Texte multilingue des blocs de texte autonomes, ou légende des blocs image :"
" {\"en\": \"…\", \"ru\": \"…\"}."

#: survey/models.py:1544
msgid "Image for standalone image blocks."
msgstr "Image des blocs image autonomes."

