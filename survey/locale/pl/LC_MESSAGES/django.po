#: survey/templatetags/i18n_extras.py:27
msgid "Click to start drawing a shape."
msgstr "Kliknij, aby zacząć rysować kształt."

#: survey/templatetags/i18n_extras.py:28
msgid "Click to continue drawing the shape."
msgstr "Kliknij, aby kontynuować rysowanie kształtu."

#: survey/templatetags/i18n_extras.py:29
msgid "Click the first point to close this shape."
msgstr "Kliknij pierwszy punkt, aby zamknąć kształt."

#: survey/templatetags/i18n_extras.py:32
msgid "Click to start drawing a line."
msgstr "Kliknij, aby zacząć rysować linię."

#: survey/templatetags/i18n_extras.py:33
msgid "Click to continue drawing the line."
msgstr "Kliknij, aby kontynuować rysowanie linii."

#: survey/templatetags/i18n_extras.py:34
msgid "Click the last point to finish the line."
msgstr "Kliknij ostatni punkt, aby zakończyć linię."

#: survey/templatetags/i18n_extras.py:39
msgid "Move the map to position the pin, then press Apply."
msgstr "Przesuń mapę, aby ustawić pinezkę, a potem naciśnij Zastosuj."

#: survey/templatetags/i18n_extras.py:40
msgid "Tap to add the shape’s corners."
msgstr "Dotykaj, aby dodać wierzchołki kształtu."

#: survey/templatetags/i18n_extras.py:41
msgid "Tap to add the next corner."
msgstr "Dotknij, aby dodać kolejny wierzchołek."

#: survey/templatetags/i18n_extras.py:42
msgid "Tap the first point to close the shape."
msgstr "Dotknij pierwszego punktu, aby zamknąć kształt."

#: survey/templatetags/i18n_extras.py:43
msgid "Tap to start the line."
msgstr "Dotknij, aby zacząć linię."

#: survey/templatetags/i18n_extras.py:44
msgid "Tap to add the next point."
msgstr "Dotknij, aby dodać kolejny punkt."

#: survey/templatetags/i18n_extras.py:45
msgid "Tap the last point to finish the line."
msgstr "Dotknij ostatniego punktu, aby zakończyć linię."

#: survey/templatetags/i18n_extras.py:49
msgid "<strong>Error:</strong> Shape edges cannot intersect!"
msgstr "<strong>Błąd:</strong> Krawędzie kształtu nie mogą się przecinać!"

#: survey/templatetags/i18n_extras.py:52
msgid "Search address..."
msgstr "Szukaj adresu..."

#: survey/templatetags/i18n_extras.py:53
msgid "No results found"
msgstr "Brak wyników"

#: survey/templatetags/i18n_extras.py:54
msgid "Search failed — check your connection and try again."
msgstr ""
"Wyszukiwanie nie powiodło się — sprawdź połączenie i spróbuj ponownie."

#: survey/templatetags/i18n_extras.py:57
msgid "Add another"
msgstr "Dodaj kolejne"

#: survey/templatetags/i18n_extras.py:58
#, python-brace-format
msgid "up to {n} more"
msgstr "jeszcze maksymalnie {n}"

#: survey/templatetags/i18n_extras.py:59
msgid "Maximum reached — remove one below to change it."
msgstr "Osiągnięto maksimum — usuń jedno poniżej, aby coś zmienić."

#: survey/templatetags/i18n_extras.py:60
#, python-brace-format
msgid "{n} marked"
msgstr "zaznaczono {n}"

#: survey/templatetags/i18n_extras.py:61
#, python-brace-format
msgid "{n} of {m} marked"
msgstr "zaznaczono {n} z {m}"

#: survey/templatetags/i18n_extras.py:62
#, python-brace-format
msgid "at least {n} required"
msgstr "wymagane co najmniej {n}"

#: survey/templatetags/i18n_extras.py:63
#, python-brace-format
msgid "All {m} marked — thank you!"
msgstr "Zaznaczono wszystkie {m} — dziękujemy!"

