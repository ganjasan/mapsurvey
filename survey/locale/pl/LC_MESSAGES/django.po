#: survey/models.py:321
msgid ""
"URL to redirect after survey completion. E.g.: /thanks/ or "
"https://example.com"
msgstr ""
"Adres przekierowania po zakończeniu ankiety. Np.: /thanks/ lub "
"https://example.com"

#: survey/models.py:322
msgid "List of ISO 639-1 language codes, e.g. [\"en\", \"ru\", \"de\"]"
msgstr "Lista kodów języków ISO 639-1, np. [\"en\", \"ru\", \"de\"]"

#: survey/models.py:323
msgid "Controls whether survey appears on the landing page"
msgstr "Decyduje o tym, czy ankieta pojawia się na stronie głównej"

#: survey/models.py:324
msgid "Marks completed surveys whose results can be shown"
msgstr "Oznacza zakończone ankiety, których wyniki można pokazać"

#: survey/models.py:325
msgid ""
"Custom HTML for thanks page. Dict keyed by language: {\"en\": "
"\"<h1>Thanks!</h1>\", \"ru\": \"<h1>Спасибо!</h1>\"} or a plain string."
msgstr ""
"Własny kod HTML strony podziękowania. Słownik z kluczem języka: {\"en\": "
"\"<h1>Thanks!</h1>\", \"ru\": \"<h1>Спасибо!</h1>\"} albo zwykły tekst."

#: survey/models.py:330
msgid ""
"Survey-level validation thresholds: {fast_threshold_seconds, "
"duplicate_window_hours}"
msgstr ""
"Progi walidacji na poziomie ankiety: {fast_threshold_seconds, "
"duplicate_window_hours}"

#: survey/models.py:331
msgid ""
"Enabled basemaps for respondent map. List from: [\"streets\", \"satellite\","
" \"topo\"]"
msgstr ""
"Mapy podkładowe włączone dla respondentów. Lista z: [\"streets\", "
"\"satellite\", \"topo\"]"

#: survey/models.py:332
msgid ""
"Default basemap shown to respondents. If null, first from basemaps list."
msgstr ""
"Domyślna mapa podkładowa pokazywana respondentom. Jeśli puste — pierwsza z "
"listy."

#: survey/models.py:333
msgid ""
"Default map position for the survey. Sections inherit this if not "
"overridden."
msgstr ""
"Domyślna pozycja mapy dla ankiety. Sekcje dziedziczą ją, o ile jej nie "
"zastąpią."

#: survey/models.py:334
msgid ""
"Default map zoom for the survey. Sections inherit this if not overridden."
msgstr ""
"Domyślne przybliżenie mapy dla ankiety. Sekcje dziedziczą je, o ile go nie "
"zastąpią."

#: survey/models.py:335
msgid "Auto-center map on respondent location when entering the survey."
msgstr ""
"Automatyczne wyśrodkowanie mapy na lokalizacji respondenta przy wejściu do "
"ankiety."

#: survey/models.py:336
msgid ""
"Show a \"Made with Mapsurvey\" link on the public survey and thanks pages (a"
" free-tier acquisition loop). Turn off for a clean, unbranded look."
msgstr ""
"Pokazuj link „Made with Mapsurvey” na publicznej stronie ankiety i stronie "
"podziękowania (pętla pozyskiwania w planie darmowym). Wyłącz, aby uzyskać "
"wygląd bez znaku firmowego."

#: survey/models.py:337
#, python-brace-format
msgid "Survey-wide style defaults: {rating_display_style}"
msgstr "Domyślne style dla całej ankiety: {rating_display_style}"

#: survey/models.py:340
msgid ""
"Set when the survey is moved to trash; purged permanently after the "
"retention window."
msgstr ""
"Ustawiane, gdy ankieta trafia do kosza; trwale usuwana po upływie okresu "
"przechowywania."

#: survey/models.py:346
msgid "For archived versions, points to the canonical survey"
msgstr "W wersjach zarchiwizowanych wskazuje ankietę kanoniczną"

#: survey/models.py:353
msgid "For draft copies, points to the canonical survey being edited"
msgstr "W kopiach roboczych wskazuje edytowaną ankietę kanoniczną"

#: survey/models.py:538
msgid "Fallback style; simplestyle properties inside the file win."
msgstr ""
"Styl zapasowy; właściwości simplestyle wewnątrz pliku mają pierwszeństwo."

#: survey/models.py:539
msgid "Feature property rendered as a permanent map label. Empty = no labels."
msgstr ""
"Właściwość obiektu wyświetlana jako stała etykieta na mapie. Puste = bez "
"etykiet."

#: survey/models.py:540
msgid ""
"Feature property that makes features addressable (reserved for answer-driven"
" map context). No UI consumer yet."
msgstr ""
"Właściwość, dzięki której obiekty można adresować (zarezerwowane dla "
"kontekstu mapy sterowanego odpowiedziami). Na razie bez zastosowania w "
"interfejsie."

#: survey/models.py:541
msgid ""
"Tap a feature shows a read-only popup of its name/description properties."
msgstr ""
"Dotknięcie obiektu otwiera okienko tylko do odczytu z jego nazwą i opisem."

#: survey/models.py:542
msgid "Re-serialized FeatureCollection — never the raw uploaded bytes."
msgstr ""
"Ponownie zserializowana kolekcja FeatureCollection — nigdy surowe przesłane "
"bajty."

#: survey/models.py:557 survey/models.py:886 survey/models.py:1454
#: survey/templates/editor/analytics_dashboard_v2.html:42
#: survey/templates/editor/partials/_mobile_nav.html:24
#: survey/templates/editor/partials/_mobile_nav.html:29
msgid "Map"
msgstr "Mapa"

#: survey/models.py:558
msgid "Form"
msgstr "Formularz"

#: survey/models.py:566
msgid ""
"\"map\" renders the panel beside the map; \"form\" renders a classic full-"
"width form with no map"
msgstr ""
"„map” wyświetla panel obok mapy; „form” wyświetla klasyczny formularz na "
"całą szerokość bez mapy"

#: survey/models.py:567
msgid ""
"Custom label for the forward button, e.g. \"Start\" on a welcome section. "
"Empty = the default Next/Finish."
msgstr ""
"Własna etykieta przycisku przejścia dalej, np. „Start” w sekcji powitalnej. "
"Puste = domyślne Dalej/Zakończ."

#: survey/models.py:575
msgid ""
"Override map position for this section. Null = keep current map position."
msgstr "Zastąp pozycję mapy w tej sekcji. Puste = zachowaj bieżącą pozycję."

#: survey/models.py:576
msgid "Override map zoom for this section. Null = keep current zoom."
msgstr ""
"Zastąp przybliżenie mapy w tej sekcji. Puste = zachowaj bieżące "
"przybliżenie."

#: survey/models.py:577
msgid "If true, fly to respondent location when entering this section."
msgstr ""
"Jeśli włączone, przy wejściu do tej sekcji mapa przeniesie się do "
"lokalizacji respondenta."

#: survey/models.py:578
msgid "Override basemap for this section. Null = keep current basemap."
msgstr "Zastąp mapę podkładową w tej sekcji. Puste = zachowaj bieżącą."

#: survey/models.py:579
msgid ""
"IDs of SurveyMapLayer rows hidden on this section. Empty = all layers "
"visible. Stale IDs are ignored at render time."
msgstr ""
"Identyfikatory warstw SurveyMapLayer ukrytych w tej sekcji. Puste = "
"wszystkie warstwy widoczne. Nieaktualne identyfikatory są pomijane przy "
"renderowaniu."

#: survey/models.py:587
msgid ""
"Show this section only when the referenced choice question's answer includes"
" any of the referenced option codes. Null = always shown."
msgstr ""
"Pokazuj tę sekcję tylko wtedy, gdy odpowiedź na wskazane pytanie wyboru "
"zawiera którykolwiek ze wskazanych kodów opcji. Puste = zawsze widoczna."

#: survey/models.py:639 survey/models.py:795
msgid "ISO 639-1 language code"
msgstr "Kod języka ISO 639-1"

#: survey/models.py:674
msgid ""
"Per-question validation: {min_value, max_value, outlier_sigma, min_length, "
"area_outlier_factor}"
msgstr ""
"Walidacja pojedynczego pytania: {min_value, max_value, outlier_sigma, "
"min_length, area_outlier_factor}"

#: survey/models.py:675
msgid "HEX color, as #RRGGBB"
msgstr "Kolor HEX w formacie #RRGGBB"

#: survey/models.py:676
msgid "Must be Font-Awesome class"
msgstr "Musi być klasą Font Awesome"

#: survey/models.py:678
msgid ""
"Rendering style: rating styles (\"default\" inherits the survey-wide style) "
"or \"dropdown\" for choice questions"
msgstr ""
"Styl wyświetlania: style oceny („default” dziedziczy styl całej ankiety) "
"albo „dropdown” dla pytań wyboru"

#: survey/models.py:681
msgid ""
"Show this question only when the referenced choice question's answer "
"includes any of the referenced option codes. Null = always shown."
msgstr ""
"Pokazuj to pytanie tylko wtedy, gdy odpowiedź na wskazane pytanie wyboru "
"zawiera którykolwiek ze wskazanych kodów opcji. Puste = zawsze widoczne."

