msgid "The file is too large (limit %(mb)s MB)."
msgstr "Plik jest za duży (limit: %(mb)s MB)."

#: survey/uploads.py:96 survey/uploads.py:98
msgid "The file does not match its declared type."
msgstr "Plik nie odpowiada zadeklarowanemu typowi."

#: survey/uploads.py:109
msgid "Too many files in this response."
msgstr "Zbyt wiele plików w tej odpowiedzi."

#: survey/uploads.py:111
msgid "The files in this response are too large overall."
msgstr "Pliki w tej odpowiedzi są łącznie za duże."

