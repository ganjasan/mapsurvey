msgid "Prefer to answer online? Scan this code."
msgstr "ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಉತ್ತರಿಸಲು ಬಯಸುವಿರಾ? ಈ ಕೋಡ್ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."

#: survey/print/pdf.py
msgid "* required"
msgstr "* ಕಡ್ಡಾಯ"
