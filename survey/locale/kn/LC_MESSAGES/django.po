msgstr "ತೆರವುಗೊಳಿಸಿ"

msgid "Record"
msgstr "ರೆಕಾರ್ಡ್"

msgid "Spray"
msgstr "ಸಿಂಪಡಿಸಿ"

msgid "Please specify"
