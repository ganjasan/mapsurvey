msgstr "ಅಪ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ"

msgid "This field is required."
msgstr "ಈ ಕ್ಷೇತ್ರ ಕಡ್ಡಾಯವಾಗಿದೆ."

msgid "up to {n} more"
msgstr "ಇನ್ನೂ {n} ವರೆಗೆ"

msgid "Tap to start the line."
msgstr "ರೇಖೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."

