msgstr "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ"

msgid "Search failed — check your connection and try again."
msgstr "ಹುಡುಕಾಟ ವಿಫಲವಾಗಿದೆ — ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."

msgid "Questions"
msgstr "ಪ್ರಶ್ನೆಗಳು"

msgid "Add another"
msgstr "ಇನ್ನೊಂದನ್ನು ಸೇರಿಸಿ"

msgid "Looks like a scam or impersonates a company"
msgstr "ವಂಚನೆಯಂತೆ ಕಾಣುತ್ತದೆ ಅಥವಾ ಕಂಪನಿಯಂತೆ ನಟಿಸುತ್ತದೆ"

msgid "{n} marked"
msgstr "{n} ಗುರುತಿಸಲಾಗಿದೆ"

msgid "Move the map to position the pin, then press Apply."
msgstr "ಪಿನ್ ಇರಿಸಲು ನಕ್ಷೆಯನ್ನು ಸರಿಸಿ, ನಂತರ ಅನ್ವಯಿಸಿ ಒತ್ತಿ."

msgid "Send report"
msgstr "ವರದಿ ಕಳುಹಿಸಿ"

msgid "Made with"
msgstr "ರಚಿಸಿದ್ದು:"

msgid "Tap to add the shape’s corners."
msgstr "ಆಕಾರದ ಮೂಲೆಗಳನ್ನು ಸೇರಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."

msgid "No"
msgstr "ಇಲ್ಲ"

msgid "{n} of {m} marked"
msgstr "{m} ರಲ್ಲಿ {n} ಗುರುತಿಸಲಾಗಿದೆ"

msgid "All {m} marked — thank you!"
msgstr "ಎಲ್ಲಾ {m} ಗುರುತಿಸಲಾಗಿದೆ — ಧನ್ಯವಾದಗಳು!"

msgid "Report this survey"
msgstr "ಈ ಸಮೀಕ್ಷೆಯನ್ನು ವರದಿ ಮಾಡಿ"

msgid "Asks for a password, a login or a payment"
msgstr "ಪಾಸ್‌ವರ್ಡ್, ಲಾಗಿನ್ ಅಥವಾ ಪಾವತಿಯನ್ನು ಕೇಳುತ್ತದೆ"

msgid "Medium brush"
msgstr "ಮಧ್ಯಮ ಬ್ರಶ್"

msgid "Sign in"
msgstr "ಸೈನ್ ಇನ್"

msgid "Hold and drag a finger to spray. Stay longer where you are more certain."
msgstr "ಸಿಂಪಡಿಸಲು ಬೆರಳನ್ನು ಒತ್ತಿ ಹಿಡಿದು ಎಳೆಯಿರಿ. ನಿಮಗೆ ಹೆಚ್ಚು ಖಚಿತವಿರುವಲ್ಲಿ ಹೆಚ್ಚು ಹೊತ್ತು ಇರಿ."

msgid "Tap to add the next corner."
msgstr "ಮುಂದಿನ ಮೂಲೆಯನ್ನು ಸೇರಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."

msgid ":"
msgstr ":"

