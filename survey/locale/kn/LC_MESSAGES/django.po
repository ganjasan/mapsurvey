#: survey/print/pdf.py
msgid "Choose all that apply"
msgstr "ಅನ್ವಯಿಸುವ ಎಲ್ಲವನ್ನೂ ಆರಿಸಿ"

#: survey/print/pdf.py
#, python-format
msgid "Answer only if %(condition)s"
msgstr "%(condition)s ಆಗಿದ್ದರೆ ಮಾತ್ರ ಉತ್ತರಿಸಿ"

#: survey/print/pdf.py
msgid "Online only"
msgstr "ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಮಾತ್ರ"

