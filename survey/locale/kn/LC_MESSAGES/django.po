msgid "Write 1 for your first choice, 2 for your second, and so on."
msgstr "ನಿಮ್ಮ ಮೊದಲ ಆಯ್ಕೆಗೆ 1, ಎರಡನೆಯದಕ್ಕೆ 2 ಹೀಗೆ ಬರೆಯಿರಿ."

#: survey/print/pdf.py
#, python-format
msgid "Page %(n)s of %(total)s"
msgstr "ಪುಟ %(n)s / %(total)s"

