msgstr "ಫೈಲ್ ಲಗತ್ತಿಸಿ"

msgid "Hold and drag to spray. Stay longer where you are more certain."
msgstr "ಸಿಂಪಡಿಸಲು ಒತ್ತಿ ಹಿಡಿದು ಎಳೆಯಿರಿ. ನಿಮಗೆ ಹೆಚ್ಚು ಖಚಿತವಿರುವಲ್ಲಿ ಹೆಚ್ಚು ಹೊತ್ತು ಇರಿ."

msgid "Sexual abuse or exploitation of children"
msgstr "ಮಕ್ಕಳ ಲೈಂಗಿಕ ದೌರ್ಜನ್ಯ ಅಥವಾ ಶೋಷಣೆ"

msgid "Exposes someone's personal data"
msgstr "ಯಾರೋ ಒಬ್ಬರ ವೈಯಕ್ತಿಕ ಡೇಟಾವನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತದೆ"

msgid "Maximum reached — remove one below to change it."
msgstr "ಗರಿಷ್ಠ ಮಿತಿ ತಲುಪಿದೆ — ಬದಲಾಯಿಸಲು ಕೆಳಗಿನ ಒಂದನ್ನು ತೆಗೆದುಹಾಕಿ."

msgid "Brush size"
msgstr "ಬ್ರಶ್ ಗಾತ್ರ"

msgid "Tap to add the next point."
msgstr "ಮುಂದಿನ ಬಿಂದುವನ್ನು ಸೇರಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."

msgid "A few required questions still need an answer."
msgstr "ಕೆಲವು ಕಡ್ಡಾಯ ಪ್ರಶ್ನೆಗಳಿಗೆ ಇನ್ನೂ ಉತ್ತರ ಬೇಕಾಗಿದೆ."

#, python-format
msgid "%(n)s question"
msgid_plural "%(n)s questions"
msgstr[0] "%(n)s ಪ್ರಶ್ನೆ"
msgstr[1] "%(n)s ಪ್ರಶ್ನೆಗಳು"

msgid "create your own free map survey"
msgstr "ನಿಮ್ಮದೇ ಉಚಿತ ನಕ್ಷೆ ಸಮೀಕ್ಷೆಯನ್ನು ರಚಿಸಿ"

msgid "Stop"
msgstr "ನಿಲ್ಲಿಸಿ"

