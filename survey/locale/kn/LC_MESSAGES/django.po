#: survey/print/pdf.py
#, python-format
msgid "Outline the area and write the letter %(letter)s inside it"
msgstr "ಪ್ರದೇಶವನ್ನು ಗುರುತಿಸಿ ಒಳಗೆ %(letter)s ಅಕ್ಷರ ಬರೆಯಿರಿ"

#: survey/print/pdf.py
#, python-format
msgid "Shade the area and write the letter %(letter)s next to it"
msgstr "ಪ್ರದೇಶಕ್ಕೆ ಛಾಯೆ ಹಾಕಿ ಪಕ್ಕದಲ್ಲಿ %(letter)s ಅಕ್ಷರ ಬರೆಯಿರಿ"

#: survey/print/pdf.py
#, python-format
msgid "up to %(n)s"
msgstr "ಗರಿಷ್ಠ %(n)s"

#: survey/print/pdf.py
#, python-format
msgid "at least %(n)s"
msgstr "ಕನಿಷ್ಠ %(n)s"

#: survey/print/pdf.py
msgid "Mark"
msgstr "ಗುರುತು"

#: survey/print/pdf.py
msgid "Object"
msgstr "ವಸ್ತು"

#: survey/print/pdf.py
#, python-format
msgid "and %(n)s more"
msgstr "ಮತ್ತು ಇನ್ನೂ %(n)s"

