msgid "Mark on the map"
msgstr "ನಕ್ಷೆಯಲ್ಲಿ ಗುರುತಿಸಿ"

#: survey/print/pdf.py
#, python-format
msgid "Draw a dot and write the letter %(letter)s next to it"
