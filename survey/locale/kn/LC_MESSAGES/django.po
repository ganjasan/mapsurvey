msgid "Add audio file"
msgstr "ಆಡಿಯೋ ಫೈಲ್ ಸೇರಿಸಿ"

msgid "Illegal content"
msgstr "ಕಾನೂನುಬಾಹಿರ ವಿಷಯ"

msgid "at least {n} required"
msgstr "ಕನಿಷ್ಠ {n} ಅಗತ್ಯವಿದೆ"

msgid "Tap the first point to close the shape."
msgstr "ಆಕಾರವನ್ನು ಮುಚ್ಚಲು ಮೊದಲ ಬಿಂದುವನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."

