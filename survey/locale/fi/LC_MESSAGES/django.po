#: survey/models.py:1212
msgid "Short markdown summary: who this is, in a few lines."
msgstr "Lyhyt markdown-tiivistelmä: kuka tämä henkilö on, muutamalla rivillä."

#: survey/models.py:1248
msgid "Creator interface language. Empty = follow the browser."
msgstr "Kyselyn laatijan käyttöliittymän kieli. Tyhjä = seuraa selainta."

#: survey/models.py:1283
msgid "Repo-relative path this note was imported from, if any."
msgstr ""
"Repositorioon nähden suhteellinen polku, josta tämä muistiinpano tuotiin, "
"jos sellainen on."

#: survey/models.py:1337
msgid "Slice within the source; meaning depends on the source."
msgstr "Osajoukko lähteen sisällä; merkitys riippuu lähteestä."

#: survey/models.py:1427
msgid "Set when the demo was opened by a signed-in user; NULL = anonymous."
msgstr "Asetetaan, kun esittelyn avasi kirjautunut käyttäjä; NULL = anonyymi."

#: survey/models.py:1442
msgid "Unlisted"
msgstr "Listaamaton"

#: survey/models.py:1446
#: survey/templates/editor/partials/_publishing_widget.html:59
#: survey/templates/editor/public_results.html:49
msgid "Live"
msgstr "Suora"

#: survey/models.py:1447 survey/templates/editor/public_results.html:49
msgid "Frozen"
msgstr "Jäädytetty"

#: survey/models.py:1453
msgid "Chart"
msgstr "Kaavio"

#: survey/models.py:1477
msgid ""
"Public is indexable and listable; unlisted is reachable by direct link only."
msgstr ""
"Julkinen on indeksoitava ja näkyy listauksissa; listaamaton avautuu vain "
"suoralla linkillä."

#: survey/models.py:1482
msgid ""
"Multilingual intro: {\"title\": {\"en\": ...}, \"body\": {\"en\": ...}} or "
"plain strings."
msgstr ""
"Monikielinen johdanto: {\"title\": {\"en\": ...}, \"body\": {\"en\": ...}} "
"tai pelkkä teksti."

#: survey/models.py:1485
msgid "Frozen per-block payloads."
msgstr "Jäädytetyt tiedot lohkoittain."

#: survey/models.py:1491
msgid ""
"Show a \"See the results\" button on the survey's thanks page (only while "
"published)."
msgstr ""
"Näytä kyselyn kiitossivulla painike ”Katso tulokset” (vain kyselyn ollessa "
"julkaistu)."

#: survey/models.py:1494
msgid "Show a card in the public stories listing (public visibility only)."
msgstr ""
"Näytä kortti julkisessa tarinalistauksessa (vain julkisella näkyvyydellä)."

#: survey/models.py:1497
msgid "Mask buckets with 0 < count < K as \"<K\". Set to 1 to disable."
msgstr ""
"Peitä ryhmät, joissa 0 < määrä < K, muodossa ”<K”. Poista käytöstä arvolla "
"1."

#: survey/models.py:1501
msgid ""
"When default blocks were auto-drafted. Set once; blocks the creator deletes "
"are never re-created."
msgstr ""
"Milloin oletuslohkot luotiin automaattisesti. Asetetaan kerran; laatijan "
"poistamia lohkoja ei luoda uudelleen."

#: survey/models.py:1528
msgid "Bound question for chart/map blocks; null for text/image."
msgstr ""
"Liitetty kysymys kaavio- ja karttalohkoille; tyhjä tekstille ja kuvalle."

#: survey/models.py:1533
msgid "Visualization override: auto, bar, pie, donut, table, heatmap, ..."
msgstr ""
"Vaihtoehtoinen visualisointi: auto, bar, pie, donut, table, heatmap, ..."

#: survey/models.py:1536
msgid "Optional multilingual title override."
msgstr "Valinnainen monikielinen otsikko oletuksen tilalle."

#: survey/models.py:1540
msgid ""
"Multilingual body for standalone text blocks, or caption for image blocks: "
"{\"en\": \"...\", \"ru\": \"...\"}."
msgstr ""
"Monikielinen sisältö erillisiin tekstilohkoihin tai kuvateksti "
"kuvalohkoihin: {\"en\": \"...\", \"ru\": \"...\"}."

#: survey/models.py:1544
msgid "Image for standalone image blocks."
msgstr "Kuva erillisiin kuvalohkoihin."

#: survey/models.py:1548
msgid ""
"Question codes whose values appear in geo popups. Empty = anonymous geometry"
" only."
msgstr ""
"Kysymyskoodit, joiden arvot näkyvät kartan ikkunoissa. Tyhjä = vain anonyymi"
" geometria."

#: survey/models.py:1552
msgid "Tile basemap for map blocks (streets/satellite/topo)."
msgstr "Karttalohkojen taustakartta (streets/satellite/topo)."

#: survey/models.py:1567
